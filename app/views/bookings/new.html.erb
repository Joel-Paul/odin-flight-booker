<h1>Book flight</h1>
<h2>
  <%= @flight.departure_airport.IATA%> ->
  <%= @flight.arrival_airport.IATA%>
</h2>
<h3>
  <%= @flight.departure_airport.name %> ->
  <%= @flight.arrival_airport.name %>
</h3>
<p>
    <%= @flight.takeoff.strftime("%v") %>
</p>
<p>
  <%= @flight.flight_info %>
</p>

<%= form_with model: @booking do |f| %>
  <%= f.hidden_field :flight_id, value: @flight.id %>
  <h4><%= pluralize(@num_tickets, "Passenger") %>:</h4>
  <ul>
    <%= f.fields_for :passengers do |s| %>
      <li>
        <%= s.label :name %>
        <%= s.text_field :name, required: true %>
        <%= s.label :email %>
        <%= s.email_field :email, required: true %>
      </li>
    <% end %>
  </ul>
  <%= f.submit %>
<% end %>
