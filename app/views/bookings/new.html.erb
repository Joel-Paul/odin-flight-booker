<h1>Book flight</h1>
<h2>
  <%= @flight.departure_airport.IATA%> ->
  <%= @flight.arrival_airport.IATA%>
</h2>
<h3>
  <%= @flight.departure_airport.name %> ->
  <%= @flight.arrival_airport.name %>
</h3>
<p>
    <%= @flight.takeoff.strftime("%v") %>
</p>
<p>
  <%= @flight.flight_info %>
</p>

<div data-controller="passenger">
  <%= form_with model: @booking do |f| %>

    <%= f.hidden_field :flight_id, value: @flight.id %>
    <h4><%= pluralize(@num_tickets, "Passenger") %></h4>
    <button type="button" data-action="passenger#add">Add passenger</button>
    <button type="button" data-action="passenger#remove">Remove passenger</button>

    <ul data-passenger-target="list">
      <%= f.fields_for :passengers do |s| %>
        <li data-passenger-target="passenger">
          <%= s.label :name %>
          <%= s.text_field :name, required: true %>
          <%= s.label :email %>
          <%= s.email_field :email, required: true %>
        </li>
      <% end %>
    </ul>

    <template data-passenger-target="template">
      <%= f.fields_for :passengers, Passenger.new do |s| %>
        <li data-passenger-target="passenger">
          <%= s.label :name %>
          <%= s.text_field :name, required: true %>
          <%= s.label :email %>
          <%= s.email_field :email, required: true %>
        </li>
      <% end %>
    </template>


    <div>
      <%= f.submit %>
    </div>

  <% end %>
</div>
